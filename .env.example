OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Only needed for gpt-5.1+ reasoning models, which reject function tools over
# /v1/chat/completions unless reasoning_effort is set. Values: none|minimal|low|medium|high|xhigh
OPENAI_REASONING_EFFORT=

# Tavily search API — get a free key at https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Langfuse observability — create a project at https://cloud.langfuse.com and paste keys below
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Chroma vector store — run locally via `docker run -p 8000:8000 chromadb/chroma`
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=brand

# Notion MCP integration (optional — agent falls back to ./data/brand for the corpus and skips publishing if unset)
# Create an integration at https://www.notion.so/profile/integrations
# Share both pages/databases with the integration before running.
NOTION_TOKEN=
NOTION_BRAND_PAGE_ID=
NOTION_DRAFTS_DATABASE_ID=

# Set to "true" to skip the Notion publish step (useful for tests)
SKIP_PUBLISH=

# Drafts database (SQLite, created automatically)
DRAFTS_DB_PATH=data/app.db
# Set to "true" to also write approved drafts as Markdown files under ./output/
WRITE_OUTPUT_FILES=

# HTTP server
PORT=3000

# Cost tracking (USD per 1M tokens). The defaults below are gpt-4o-mini's rates
# and are correct ONLY for that model — every cost the CLI and dashboard report
# is wrong otherwise. Set both to your model's published rates; startup warns
# when OPENAI_MODEL is something else and these are unset.
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60
# Hard token cap per run (0 or empty = unlimited)
MAX_RUN_TOKENS=

# LLM call timeout in milliseconds
LLM_TIMEOUT_MS=120000

# Shared password for the deployed demo (unset = no auth, local dev default)
DEMO_PASSWORD=

# Vector store backend: chroma (local dev) | memory (no Chroma service needed)
VECTOR_STORE=chroma

# Next.js dashboard
API_ORIGIN=http://localhost:3000
NEXT_PORT=3001

# Set to "true" to expose GET /debug/sse-ping for proxy buffering diagnostics
ENABLE_SSE_DEBUG=
