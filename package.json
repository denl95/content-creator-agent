{
  "name": "content-creator-agent",
  "module": "src/graph.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "studio": "bunx @langchain/langgraph-cli dev",
    "check": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "typecheck": "tsc --noEmit",
    "serve": "bun run src/server.ts",
    "web": "cd web && bun run dev --port ${NEXT_PORT:-3001}",
    "dev:all": "bun run serve & bun run web",
    "test:unit": "bun test tests/unit",
    "test:judge": "DRAFTS_DB_PATH=:memory: MAX_ITERATIONS=2 MAX_SEARCHES=3 bun test tests/judge",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "reindex": "bun run scripts/reindex.ts",
    "upload-prompts": "bun run scripts/upload-prompts.ts",
    "upload-brand": "bun run scripts/upload-brand.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "1.3.13",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.41",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.4",
    "@langchain/tavily": "^1.2.0",
    "@langfuse/client": "^5.3.0",
    "@langfuse/langchain": "^5.3.0",
    "@langfuse/otel": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@opentelemetry/sdk-node": "^0.216.0",
    "@prisma/adapter-libsql": "7",
    "@prisma/client": "7",
    "chromadb": "^3.4.3",
    "dotenv": "^17.4.2",
    "hono": "^4.12.30",
    "langchain": "^1.3.4",
    "prisma": "7",
    "zod": "^3"
  }
}
